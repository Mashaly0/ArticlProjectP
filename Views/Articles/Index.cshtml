@using System.Security.Claims
@model IEnumerable<ArticlProject.Models.Article>

@{
    ViewData["Title"] = "المقالات";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>قائمة المقالات</h1>
        @if (User.Identity.IsAuthenticated)
        {
            <div>
                <a asp-action="Create" class="btn btn-primary me-2">
                    <i class="bi bi-plus-circle me-1"></i>إنشاء مقال جديد
                </a>
                <a asp-action="MyArticles" class="btn btn-outline-primary">
                    <i class="bi bi-person me-1"></i>مقالاتي
                </a>
            </div>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/images/@item.Image" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-primary">@item.Type</span>
                        </div>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text flex-grow-1">@item.Description.Substring(0, Math.Min(100, item.Description.Length))...</p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>@item.Author?.Name
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>@item.CreatedDate.ToString("yyyy-MM-dd")
                                </small>
                            </div>

                            <div class="btn-group w-100">
                                <a asp-action="Details" asp-route-id="@item.ArticleId" class="btn btn-info btn-sm">تفاصيل</a>

                                @if (User.Identity.IsAuthenticated && (item.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier) || User.IsInRole("Admin")))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.ArticleId" class="btn btn-warning btn-sm">تعديل</a>
                                    <a asp-action="Delete" asp-route-id="@item.ArticleId" class="btn btn-danger btn-sm">حذف</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>