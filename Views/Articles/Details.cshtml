@model ArticlProject.Models.Article

@{
    ViewData["Title"] = "تفاصيل المقال";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- رأس المقال -->
            <div class="text-center mb-5">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المقالات</a></li>
                        <li class="breadcrumb-item active">تفاصيل المقال</li>
                    </ol>
                </nav>

                <span class="badge bg-primary fs-6 mb-3 px-3 py-2">@Model.Type</span>
                <h1 class="display-5 fw-bold text-dark mb-3">@Model.Title</h1>

                <div class="d-flex justify-content-center align-items-center gap-4 text-muted flex-wrap">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle me-2"></i>
                        <span>@Model.Author?.Name</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calendar-event me-2"></i>
                        <span>@Model.CreatedDate.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-clock me-2"></i>
                        <span>@Model.CreatedDate.ToString("hh:mm tt")</span>
                    </div>
                </div>
            </div>

            <!-- صورة المقال -->
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <div class="text-center mb-5">
                    <img src="~/images/@Model.Image" class="img-fluid rounded shadow-lg" alt="@Model.Title"
                         style="max-height: 500px; width: 100%; object-fit: cover;">
                </div>
            }
            else
            {
                <div class="text-center mb-5">
                    <div class="bg-light rounded shadow-lg d-flex align-items-center justify-content-center"
                         style="height: 300px;">
                        <i class="bi bi-image text-muted display-1"></i>
                    </div>
                </div>
            }

            <!-- محتوى المقال -->
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <div class="article-content">
                        @Html.Raw(Model.Description.Replace("\n", "<br>"))
                    </div>
                </div>
            </div>

            <!-- معلومات الكاتب -->
            <div class="card border-0 bg-light mb-5">
                <div class="card-body p-4">
                    <h4 class="text-primary mb-4">عن الكاتب</h4>
                    <div class="row align-items-center">
                        <div class="col-md-2 text-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.Author?.Image))
                            {
                                <img src="~/images/@Model.Author.Image" class="rounded-circle img-thumbnail"
                                     alt="@Model.Author.Name" style="width: 100px; height: 100px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto"
                                     style="width: 100px; height: 100px;">
                                    <i class="bi bi-person text-white fs-2"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-10">
                            <h5 class="text-primary mb-2">@Model.Author?.Name</h5>
                            <p class="text-muted mb-3">@Model.Author?.About</p>
                            <div class="d-flex gap-2">
                                <span class="badge bg-secondary">
                                    <i class="bi bi-file-text me-1"></i>
                                    @(Model.Author?.Articles?.Count ?? 0) مقالة
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- مقالات أخرى لنفس الكاتب -->
            @if (Model.Author != null && Model.Author.Articles != null && Model.Author.Articles.Any(a => a.ArticleId != Model.ArticleId))
            {
                <div class="mt-5">
                    <h3 class="mb-4 border-bottom pb-3">مقالات أخرى من @Model.Author.Name</h3>
                    <div class="row">
                        @foreach (var relatedArticle in Model.Author.Articles.Where(a => a.ArticleId != Model.ArticleId).Take(3))
                        {
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 border-0 shadow-sm article-card">
                                    @if (!string.IsNullOrEmpty(relatedArticle.Image))
                                    {
                                        <img src="~/images/@relatedArticle.Image" class="card-img-top"
                                             alt="@relatedArticle.Title" style="height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                             style="height: 200px;">
                                            <i class="bi bi-image text-white fs-1"></i>
                                        </div>
                                    }
                                    <div class="card-body d-flex flex-column">
                                        <span class="badge bg-primary mb-2">@relatedArticle.Type</span>
                                        <h5 class="card-title">@relatedArticle.Title</h5>
                                        <p class="card-text text-muted flex-grow-1">
                                            @relatedArticle.Description.Substring(0, Math.Min(100, relatedArticle.Description.Length))...
                                        </p>
                                        <div class="mt-auto">
                                            <small class="text-muted d-block mb-2">
                                                <i class="bi bi-calendar me-1"></i>
                                                @relatedArticle.CreatedDate.ToString("yyyy-MM-dd")
                                            </small>
                                            <a asp-action="Details" asp-route-id="@relatedArticle.ArticleId"
                                               class="btn btn-outline-primary btn-sm w-100">قراءة المزيد</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- أزرار التحكم -->
            <div class="d-flex justify-content-between align-items-center p-4 bg-light rounded mt-5">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-right me-1"></i>العودة للقائمة
                    </a>
                </div>

                <div class="btn-group">
                    <a asp-action="Edit" asp-route-id="@Model.ArticleId" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>تعديل
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ArticleId" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>حذف
                    </a>
                </div>
            </div>

            <!-- أزرار المشاركة -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">شارك هذا المقال</h5>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="https://twitter.com/intent/tweet?text=@Uri.EscapeDataString(Model.Title)&url=@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path"
                           class="btn btn-outline-primary btn-sm" target="_blank">
                            <i class="bi bi-twitter me-1"></i>تويتر
                        </a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path"
                           class="btn btn-outline-primary btn-sm" target="_blank">
                            <i class="bi bi-facebook me-1"></i>فيسبوك
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path"
                           class="btn btn-outline-primary btn-sm" target="_blank">
                            <i class="bi bi-linkedin me-1"></i>لينكد إن
                        </a>
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyToClipboard()">
                            <i class="bi bi-link-45deg me-1"></i>نسخ الرابط
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .article-content {
            line-height: 1.8;
            font-size: 1.1rem;
            color: #2c3e50;
            text-align: justify;
        }

            .article-content h1,
            .article-content h2,
            .article-content h3 {
                color: #2c3e50;
                margin-top: 2rem;
                margin-bottom: 1rem;
                font-weight: bold;
            }

            .article-content h1 {
                font-size: 2rem;
            }

            .article-content h2 {
                font-size: 1.75rem;
            }

            .article-content h3 {
                font-size: 1.5rem;
            }

            .article-content p {
                margin-bottom: 1.5rem;
            }

            .article-content img {
                max-width: 100%;
                height: auto;
                border-radius: 10px;
                margin: 1rem 0;
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            }

            .article-content blockquote {
                border-right: 4px solid #007bff;
                padding-right: 1rem;
                margin: 1.5rem 0;
                font-style: italic;
                color: #6c757d;
            }

        .breadcrumb {
            background: transparent;
            padding: 0;
        }

        .breadcrumb-item a {
            text-decoration: none;
            color: #6c757d;
            transition: color 0.3s;
        }

            .breadcrumb-item a:hover {
                color: #007bff;
            }

        .breadcrumb-item.active {
            color: #495057;
            font-weight: 500;
        }

        .article-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .article-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
            }

        .btn-group .btn {
            border-radius: 0.375rem;
        }
    </style>
}

@section Scripts {
    <script>
        function copyToClipboard() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(function() {
                // إظهار رسالة نجاح
                const originalText = event.target.innerHTML;
                event.target.innerHTML = '<i class="bi bi-check me-1"></i>تم النسخ!';
                event.target.classList.remove('btn-outline-secondary');
                event.target.classList.add('btn-success');

                setTimeout(() => {
                    event.target.innerHTML = originalText;
                    event.target.classList.remove('btn-success');
                    event.target.classList.add('btn-outline-secondary');
                }, 2000);
            }).catch(function(err) {
                alert('حدث خطأ أثناء نسخ الرابط: ' + err);
            });
        }

        // إضافة تأثيرات للصور في المحتوى
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('.article-content img');
            images.forEach(img => {
                img.style.cursor = 'pointer';
                img.addEventListener('click', function() {
                    this.classList.toggle('img-fluid');
                });
            });

            // إضافة تأثيرات للبطاقات
            const cards = document.querySelectorAll('.article-card');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        });

        // تنفيط الأرقام في عدد المقالات
        function formatNumber(num) {
            return new Intl.NumberFormat('ar-EG').format(num);
        }

        // تطبيق التنفيط على عناصر الإحصائيات
        document.addEventListener('DOMContentLoaded', function() {
            const statElements = document.querySelectorAll('.stats-count');
            statElements.forEach(element => {
                const count = parseInt(element.textContent);
                if (!isNaN(count)) {
                    element.textContent = formatNumber(count);
                }
            });
        });
    </script>
}