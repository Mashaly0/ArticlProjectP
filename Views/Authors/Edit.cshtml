@model ArticlProject.Models.Author

@{
    ViewData["Title"] = "تعديل المؤلف";
}

<div class="container">
    <h1>تعديل المؤلف</h1>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="AuthorId" />

                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="About" class="control-label"></label>
                    <textarea asp-for="About" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="About" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>الصورة الحالية:</label>
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div>
                            <img src="~/images/@Model.Image" class="img-thumbnail" style="max-height: 200px;" alt="الصورة الحالية">
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">لا توجد صورة حالية</p>
                    }
                </div>

                <div class="form-group">
                    <label asp-for="ImageFile" class="control-label">تغيير الصورة</label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="حفظ التعديلات" class="btn btn-primary" />
                    <a asp-action="Details" asp-route-id="@Model.AuthorId" class="btn btn-info">تفاصيل</a>
                    <a asp-action="Index" class="btn btn-secondary">العودة للقائمة</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}